  "meta": {
    "working_title": "Palworld: Los Santos",
    "host": {
      "game": "palworld",
      "role": "primary",
      "loader": "ue4ss"
    },
    "companion": {
      "game": "gta-v",
      "role": "required",
      "launch_ref": "{game:gta-v}",
      "note": "Required host-side game. GTA V content (cars, characters, map, sound) is read from the player's own copy; nothing from GTA V is copied or uploaded. Story mode only. GTA V does NOT run beside Palworld: everything is played in the Palworld window."
    },
    "mode": "multiplayer (Palworld dedicated/host session)",
    "status": "DESIGN ONLY - not built, not tested, not published",
    "open_obstacles": [
      "GTA V map/models/vehicles live in proprietary RPF archives; loading them into Unreal at runtime is the hardest part. Agent must pick a route (runtime reader/converter, or GTA running beside Palworld via recipe.together passing events) and get the user's agreement if the design must change.",
      "GTA V Legacy story mode is single player; GTA is never the multiplayer layer. Players join the Palworld session.",
      "Player counts (120 in world, 500 supported) are targets to be measured in testing, not promised. maxPlayers must be the tested number.",
      "No planes/boats: removing them is a removal in GTA content; flying/swimming pals replace them."
    ],
    "v1_scope": "Small first playable: Palworld world with GTA map layout as the region, pal mounts without saddles, spear catching, 5 GTA vehicles stealable, 3 weapons at an ammu-shop, 1 bank selling build materials, 1 GTA boss, XP cap 300, one base with radius 3x.",
    "fill_status": "Cells filled with proposed design values on 2026-10-12. None verified against game files. Design decisions updated 2026-10-12 after owner chat.",
    "gta_route": {
      "status": "DECIDED by owner (route unproven)",
      "decision": "Single window: everything is played inside Palworld. GTA V is required and is the source of real content (vehicles, characters, map, sound) read from the player's own install at runtime.",
      "replaces": "Earlier proposal (recipe.together, GTA running beside Palworld) was NOT chosen.",
      "obstacle": "Loading GTA V's RPF archive content into Unreal at runtime is unproven. If a part proves impossible, explain it and get the owner's agreement before changing the design.",
      "real_gta_parts": [
        "cars (Futo, Sultan, Buffalo)",
        "characters (Franklin, Michael, Trevor)",
        "Los Santos map",
        "sound"
      ]
    },
    "credits": {
      "author": "Wolf001",
      "license": "CC-BY-4.0",
      "remix_allowed": true,
      "attribution_required": true
    }
